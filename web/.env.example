# Copy to .env.local (never commit real values). All variables are server-side only.

# Postgres connection (Supabase: Project Settings → Database → connection string).
# Use the transaction pooler (port 6543) on Vercel.
DATABASE_URL=postgres://postgres:CHANGE_ME@127.0.0.1:54329/fastrobox

# demo = simulated devices allowed (all their data is labelled SIMULATED DATA)
# live = simulated devices are rejected and hidden (use for judging)
APP_MODE=live

SESSION_TTL_HOURS=12
APP_TIMEZONE=Asia/Dhaka

# Phone alerts (Level 4): Telegram bot token from @BotFather. Users link a chat id in their profile.
TELEGRAM_BOT_TOKEN=

# School location for the weather panel (Level 6). Open-Meteo needs no key.
WEATHER_LATITUDE=23.8103
WEATHER_LONGITUDE=90.4125
WEATHER_LOCATION_NAME=Dhaka

# Face verification service (Level 7/8), see ml/face_service/README.md
FACE_SERVICE_URL=
FACE_SERVICE_TOKEN=

# Shared secret for the external scheduler calling /api/cron/tick
CRON_SECRET=

# Initial admin account for `npm run seed:admin` (removed from the environment afterwards)
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
